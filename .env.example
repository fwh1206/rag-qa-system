# 必填：DeepSeek API Key
DEEPSEEK_API_KEY=
# 可选：模型名称与接口地址
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions

# 鉴权
RAG_AUTH_ENABLED=1
RAG_AUTH_USER=admin
RAG_AUTH_PASSWORD=admin123
RAG_AUTH_TOKEN_TTL=86400

# 邮箱验证码（未配置 SMTP 时本地开发模式会把验证码直接返回给前端）
RAG_EMAIL_SMTP_HOST=
RAG_EMAIL_SMTP_PORT=465
RAG_EMAIL_SMTP_USER=
RAG_EMAIL_SMTP_PASSWORD=
RAG_EMAIL_FROM=
RAG_EMAIL_USE_SSL=1
RAG_EMAIL_CODE_TTL=600
# 仅本地调试用；生产环境必须配置 SMTP 并保持为 0
RAG_EMAIL_DEV_MODE=0

# MySQL
RAG_DB_HOST=127.0.0.1
RAG_DB_PORT=3306
RAG_DB_USER=root
RAG_DB_PASSWORD=root
RAG_DB_NAME=rag_qa_db
RAG_DB_CHARSET=utf8mb4
RAG_DB_POOL_SIZE=8

# 跨域白名单，多个用英文逗号分隔
RAG_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
